POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=client_project_mgmt

DATABASE_URL=postgresql://postgres:postgres@db:5432/client_project_mgmt

JWT_SECRET=change-me-to-a-long-random-secret

PORT=4000

# Baked into the frontend bundle at `docker compose build` time. Local dev
# defaults to http://localhost:4000/api and needs nothing here. Remote
# deployment uses docker-compose.prod.yml (see README) — set this only to
# override the address that overlay bakes in.
# VITE_API_BASE_URL=http://192.168.1.85:4000/api
