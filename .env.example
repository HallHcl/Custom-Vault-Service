POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=client_project_mgmt

DATABASE_URL=postgresql://postgres:postgres@db:5432/client_project_mgmt

JWT_SECRET=change-me-to-a-long-random-secret

PORT=4000

# Baked into the frontend bundle at build time by `docker compose build frontend`.
# Must be an address the browser can reach: localhost for same-machine use, or
# the Docker host's LAN IP (e.g. http://192.168.1.50:4000/api) to reach the app
# from other devices. Overrides the default in docker-compose.yml.
VITE_API_BASE_URL=http://localhost:4000/api
